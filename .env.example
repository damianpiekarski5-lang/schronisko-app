# Client-side Firebase config for Google login and "Moje psy".
# W Create React App variables exposed to the browser must start with REACT_APP_.
REACT_APP_FIREBASE_API_KEY=your_api_key
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# Optional aliases supported by the app (useful for shared hosting environments).
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_APP_ID=
