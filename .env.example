# Konfiguracja klienta (widoczna w przeglądarce — to nie są sekrety)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
REACT_APP_FIREBASE_MEASUREMENT_ID=

# Kto ma panel administratora — lista adresów po przecinku.
# Bez tej zmiennej nikt nie ma uprawnień administratora.
REACT_APP_ADMIN_EMAILS=

# Kto ma panel behawiorysty. Bez tej zmiennej panel jest niedostępny.
REACT_APP_BEHAVIORYST_EMAIL=

# Konfiguracja serwera (sekrety — tylko w panelu Vercel, nigdy w repozytorium)
ADMIN_EMAILS=
APPS_SCRIPT_URL=
APPS_SCRIPT_SHARED_SECRET=
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=
