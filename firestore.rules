rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Biblioteka ćwiczeń — dostępna dla wszystkich zalogowanych
    match /exercises/{exerciseId} {
      allow read, write: if request.auth != null;
    }

    // Programy treningowe — dostępne dla wszystkich zalogowanych
    match /programs/{programId} {
      allow read, write: if request.auth != null;
    }

    // Dane treningowe per pies — rekurencyjny wildcard obejmuje
    // dogTraining/{dogId}, dogTraining/{dogId}/progress/*, dogTraining/{dogId}/sessions/*
    match /dogTraining/{path=**} {
      allow read, write: if request.auth != null;
    }
  }
}
