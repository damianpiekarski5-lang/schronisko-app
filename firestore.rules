rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Biblioteka ćwiczeń
    match /exercises/{exerciseId} {
      allow read, write: if request.auth != null;
    }

    // Programy treningowe
    match /programs/{programId} {
      allow read, write: if request.auth != null;
    }

    // Dane treningowe per pies — {path=**} obejmuje dokument główny
    // oraz podkolekcje: progress/* i sessions/*
    match /dogTraining/{path=**} {
      allow read, write: if request.auth != null;
    }

    // Zaplanowane spacery (widok tabelaryczny — przyszłe dni)
    match /plannedWalks/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }

    // Grafik obecności wolontariuszy
    match /scheduleEntries/{docId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if request.auth != null;
    }
  }
}
